# Local development only. Set a password and use the same URL-encoded value in DATABASE_URL.
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=fieldops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fieldops:replace-with-a-local-password@127.0.0.1:5432/fieldops
HOST=127.0.0.1
PORT=3001
# Tests require a separate disposable database, never your application database.
# TEST_DATABASE_URL=postgresql://fieldops:replace-with-a-local-password@127.0.0.1:5432/fieldops_test

# Development remains loopback-only. Production secrets belong to host runtime settings.
API_MODE=development
# Production also requires generated API_TOKEN and canonical HTTPS CORS_ORIGINS.
# Never set API_TOKEN in VITE_* variables, commit it, or include it in a Docker build.
